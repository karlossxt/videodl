# Copia este archivo como ".env" y ajusta lo que necesites.
# Todas las variables son opcionales: sin ellas la app usa valores por defecto.

# ---- Servidor ---------------------------------------------------------------
# Puerto de escucha (las plataformas suelen inyectarlo solas).
PORT=8000
# Nivel de logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# URL pública del sitio, sin barra final. Se usa en canonical, Open Graph,
# sitemap.xml, robots.txt y datos estructurados. Si se omite, se usa
# https://fastools.org. Descomenta y cambia solo en local o staging.
# SITE_URL=http://localhost:8000
# Nombre visible de la marca (separado del dominio canónico en SITE_URL).
SITE_NAME=Fastools
# IPs de proxy de confianza para leer X-Forwarded-For (uvicorn).
# Déjalo en 127.0.0.1 salvo que estés detrás de un proxy de confianza
# (en ese caso, pon la IP del proxy; usar "*" permite falsear la IP).
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Límites y seguridad ----------------------------------------------------
# Peticiones por minuto y por IP (0 = sin límite).
RATE_LIMIT_PER_MINUTE=60
# Trabajos pesados (compresión/clip) simultáneos como máximo.
MAX_CONCURRENT_JOBS=4
# Orígenes permitidos por CORS, separados por comas (vacío = mismo origen).
CORS_ORIGINS=
# Content-Security-Policy. Vacío = se desactiva (se usa una por defecto sensata).
CONTENT_SECURITY_POLICY=

# ---- Vídeo ------------------------------------------------------------------
# Tamaño máximo de archivo que se puede subir (MB).
MAX_UPLOAD_MB=200
# Tope del tamaño objetivo del compresor (MB).
COMPRESS_MAX_TARGET_MB=200
# Preset de x264 (ultrafast…placebo). En CPU modestas: veryfast o ultrafast.
X264_PRESET=veryfast
# Duración máxima de un clip (segundos).
CLIP_MAX_SECONDS=300
# Tiempo máximo de un proceso ffmpeg antes de matarlo (segundos, 0 = sin límite).
FFMPEG_TIMEOUT_SECONDS=3600

# ---- Transcripción de audio (opcional) --------------------------------------
# Requiere instalar requirements-transcribe.txt; si falta, la herramienta
# responde 503 y el resto del sitio funciona igual.
# Modelo de faster-whisper: tiny, base, small, medium, large-v3 (o variantes .en).
# En CPU y planes pequeños: tiny o base. Para español, small mejora la precisión.
TRANSCRIBE_MODEL=base
# Dispositivo y precisión: cpu/cuda/auto e int8/float16/float32.
TRANSCRIBE_DEVICE=cpu
TRANSCRIBE_COMPUTE_TYPE=int8
# 1 = más rápido; 5 = algo más preciso (y más lento).
TRANSCRIBE_BEAM_SIZE=1
# Duración máxima del audio y tamaño máximo de subida.
TRANSCRIBE_MAX_SECONDS=1800
TRANSCRIBE_MAX_MB=100
# Idioma fijo (es, en, pt…) o vacío para detección automática.
TRANSCRIBE_LANGUAGE=
