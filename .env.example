# Copia este archivo como ".env" y ajusta lo que necesites.
# Todas las variables son opcionales: sin ellas la app usa valores por defecto.

# ---- Servidor ---------------------------------------------------------------
# Puerto de escucha (las plataformas suelen inyectarlo solas).
PORT=8000
# Nivel de logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# IPs de proxy de confianza para leer X-Forwarded-For (uvicorn).
# Déjalo en 127.0.0.1 salvo que estés detrás de un proxy de confianza
# (en ese caso, pon la IP del proxy; usar "*" permite falsear la IP).
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Límites y seguridad ----------------------------------------------------
# Peticiones por minuto y por IP (0 = sin límite).
RATE_LIMIT_PER_MINUTE=60
# Trabajos pesados (descarga/compresión/clip) simultáneos como máximo.
MAX_CONCURRENT_JOBS=4
# Orígenes permitidos por CORS, separados por comas (vacío = mismo origen).
CORS_ORIGINS=
# Content-Security-Policy. Vacío = se desactiva (se usa una por defecto sensata).
CONTENT_SECURITY_POLICY=

# ---- Vídeo ------------------------------------------------------------------
# Tamaño máximo de archivo que se puede subir (MB).
MAX_UPLOAD_MB=200
# Tope del tamaño objetivo del compresor (MB).
COMPRESS_MAX_TARGET_MB=200
# Preset de x264 (ultrafast…placebo). En CPU modestas: veryfast o ultrafast.
X264_PRESET=veryfast
# Duración máxima de un clip (segundos).
CLIP_MAX_SECONDS=300
# Margen de seguridad que se descarga de más en cada extremo del clip (segundos).
CLIP_PAD_SECONDS=12
# Tope de descarga cuando el enlace no admite fragmentos (MB).
CLIP_MAX_FULL_DOWNLOAD_MB=500
# Tiempo máximo de un proceso ffmpeg antes de matarlo (segundos, 0 = sin límite).
FFMPEG_TIMEOUT_SECONDS=3600
# Timeout de red de yt-dlp (segundos, 0 = sin límite).
YTDLP_SOCKET_TIMEOUT=30
# Proxy para las peticiones de yt-dlp (opcional). Sirve para salir con otra IP
# cuando la plataforma bloquea la del servidor, p. ej. YouTube desde un
# datacenter. Ejemplo: http://usuario:clave@host:8080  o  socks5://host:1080
YTDLP_PROXY=
# Cliente de extracción de yt-dlp (opcional), con el formato de --extractor-args.
# Ejemplo para YouTube: youtube:player_client=tv,web_safari
YTDLP_EXTRACTOR_ARGS=
# Segundos que se le dejan al proveedor de PO tokens (bgutil) para firmar cada
# petición a YouTube. El plugin corta a 20 s, poco para un plan gratuito
# (0,1 CPU): por eso se amplía. Con 0 se desactiva el proveedor (para comparar).
YTDLP_POT_TIMEOUT=60
# Plataformas que se rechazan al instante (lista separada por comas). Por
# defecto YouTube y Reddit: desde un servidor necesitan un proxy de pago.
# Con VIDEODL_DISABLED_PLATFORMS="" se vuelven a permitir todas.
VIDEODL_DISABLED_PLATFORMS=youtube,reddit

# ---- Cookies (opcional, para YouTube y Reddit desde servidor) ---------------
# Se pueden dar de cuatro formas; la app las busca en este orden:
# 1) Ruta a un cookies.txt existente en el servidor.
YTDLP_COOKIES_FILE=
# 2) El contenido del cookies.txt directamente (texto, formato Netscape).
YTDLP_COOKIES=
# 3) El mismo contenido en Base64.
YTDLP_COOKIES_B64=
# (4) Un Secret File montado en /etc/secrets/cookies.txt — no necesita variable.
#     Puedes añadir más de uno (reddit.txt, por ejemplo): se unen solos y cada
#     web recibe solo las cookies de su dominio.
